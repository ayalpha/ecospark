rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════════
// EcoSpark Firestore security rules
//
// Governing principle: the client may never write anything of value. Points,
// roles, bans and inventory are mutated only by the trusted serverless functions
// in api/ (Admin SDK, which bypasses these rules by design). What remains here
// is the boundary for everything the browser is still allowed to touch.
//
// Verify with the emulator before deploying:
//   firebase emulators:start --only firestore
// ═══════════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }



    function getRole() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      let role = userDoc != null ? userDoc.data.get('role', 'student') : 'student';
      // Default to 'student' if role is null, undefined, or empty string
      return (role == null || role == '' || role == 'user') ? 'student' : role;
    }

    function isSupremeAdmin() {
      // Safely check for supreme admins. If token doesn't have email, it returns false instead of crashing.
      return isAuthenticated() && (request.auth.token.email == 'amiteshyadav.yt@gmail.com' || request.auth.token.email == 'shivika.op@gmail.com');
    }

    function isOwner() {
      return isSupremeAdmin() || (isAuthenticated() && getRole() == 'owner');
    }

    function isAdmin() {
      return isSupremeAdmin() || (isAuthenticated() && (getRole() == 'admin' || getRole() == 'owner' || getRole() == 'teacher'));
    }

    function isStaff() {
      return isSupremeAdmin() || (isAuthenticated() && (getRole() == 'teacher' || getRole() == 'admin' || getRole() == 'owner'));
    }

    function touchesProtectedFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'role', 'banned',
        // Follow counters are owned by api/follow.js (Admin SDK, one atomic
        // transaction per follow/unfollow). A user must never be able to set
        // their own — it would be trivial to forge popularity.
        'followersCount', 'followingCount',
        // The @username handle and its 3-per-30-days change ledger are owned
        // by api/username.js: uniqueness is enforced by /usernames claim docs
        // in one server transaction, and the quota must not be resettable
        // client-side.
        'username', 'usernameChanges',
      ]);
    }

    function isChatParticipant(chatId) {
      return isAuthenticated() &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    // ── USERS ──────────────────────────────────────────────────────────────
    // Previously `allow update: if isAuthenticated()`, which let any signed-in
    // user rewrite any other user's points, role and inventory.
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Ensure users cannot create an account with a role other than 'user'
      allow create: if isSelf(userId) && (!('role' in request.resource.data) || request.resource.data.role == 'user');

      // Since we are running fully client-side without Vercel API, 
      // users must be allowed to update their own stats/inventory.
      allow update: if isStaff() || (isSelf(userId) && !touchesProtectedFields());

      // Deletion would orphan ledger entries and leaderboard rows unless handled properly by the admin client.
      allow delete: if isStaff();
    }

    // ── POINT LEDGER (append-only, server-written) ─────────────────────────
    match /pointTransactions/{entryId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read: if isStaff();
      allow create, update: if false;
      allow delete: if isStaff();
    }

    // ── AUDIT LOG (owner-readable, server-written) ─────────────────────────
    match /auditLog/{entryId} {
      allow read: if isOwner();
      allow write: if false;
    }

    // ── TASKS ──────────────────────────────────────────────────────────────
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // ── SUBMISSIONS ────────────────────────────────────────────────────────
    match /submissions/{submissionId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read: if isStaff();

      // A student may submit their own work, but must not pre-set the verdict
      // or the payout — those come from verification and the task definition.
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending';

      // Status transitions belong to the verifier and to staff review.
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isStaff());
      allow delete: if isStaff();
    }

    // ── LEADERBOARD (public read, values must mirror the user doc) ────────
    // Was writable by the row's owner, which meant points could be forged here
    // even once /users was locked. The row is still written client-side (the
    // ActivityTracker mirror and the task-award transaction both write it), so
    // the owner keeps limited self-access — but the row can never report MORE
    // than the owner's /users doc:
    //   • a ranked value may move only by the same delta as the user doc in
    //     the same batch (the award-transaction pattern), or
    //   • land at/below the user doc's post-write value (the mirror pattern),
    //   • or not move at all (housekeeping writes: photo, groupId, …).
    // All checks anchor to the user doc's POST-write state (getAfter), so the
    // award transaction — which bumps both docs in one batch — passes even
    // when the row was briefly stale. Staff keep full access.
    match /leaderboard/{userId} {
      allow read: if isAuthenticated();

      function lbUserAfter() {
        return getAfter(/databases/$(database)/documents/users/$(userId)).data;
      }

      function lbCreateOk() {
        let u = lbUserAfter();
        let d = request.resource.data;
        return d.userId == request.auth.uid
          && (!('points' in d) || d.points <= u.get('lifetimePoints', u.get('points', 0)))
          && (!('weeklyPoints' in d) || d.weeklyPoints <= u.get('weeklyPoints', 0))
          && (!('streak' in d) || d.streak <= u.get('streak', 0))
          && (!('displayName' in d) || d.displayName == u.get('displayName', 'EcoUser'));
      }

      function lbUpdateOk() {
        let uB = get(/databases/$(database)/documents/users/$(userId)).data;
        let uA = lbUserAfter();
        let d = request.resource.data;
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        // Only the mirror's own fields may ever change on an update.
        let keysOk = changed.hasOnly([
          'userId', 'displayName', 'photoURL', 'points', 'weeklyPoints',
          'streak', 'groupId', 'showOnLeaderboard', 'updatedAt',
        ]);
        let pointsOk = !changed.hasAny(['points'])
          || d.points <= uA.get('lifetimePoints', uA.get('points', 0))
          || ('points' in resource.data
              && d.points - resource.data.points
                 == uA.get('lifetimePoints', uA.get('points', 0))
                    - uB.get('lifetimePoints', uB.get('points', 0)));
        let weeklyOk = !changed.hasAny(['weeklyPoints'])
          || d.weeklyPoints <= uA.get('weeklyPoints', 0)
          || ('weeklyPoints' in resource.data
              && d.weeklyPoints - resource.data.weeklyPoints
                 == uA.get('weeklyPoints', 0) - uB.get('weeklyPoints', 0));
        let streakOk = !changed.hasAny(['streak'])
          || d.streak == uA.get('streak', 0);
        let nameOk = !changed.hasAny(['displayName'])
          || d.displayName == uA.get('displayName', 'EcoUser');
        return d.userId == request.auth.uid && keysOk && pointsOk && weeklyOk && streakOk && nameOk;
      }

      allow create: if isStaff() || (isSelf(userId) && lbCreateOk());
      allow update: if isStaff() || (isSelf(userId) && lbUpdateOk());
      allow delete: if isStaff();
    }

    // ── REWARDS CATALOG ────────────────────────────────────────────────────
    match /rewards/{rewardId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // ── REDEMPTIONS / TRANSACTIONS (server-written) ───────────────────────
    match /redemptions/{redemptionId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read: if isStaff();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isStaff();
    }

    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read: if isStaff();
      // History mirrors are append-only and self-attributed: the client-side
      // economy (task awards, referrals, oracle payouts, trade closes) may
      // append an entry for itself, but never edit or delete history.
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isStaff();
    }

    // ── CRYPTO PAYOUTS (Wallet) ────────────────────────────────────────────
    // A payout request locks points the moment it is created (the client
    // deducts spendableBalance in the same breath). Users may create pending
    // requests for themselves and cancel their own still-pending ones; only
    // staff can mark requests paid (with a txid) or reject them (points are
    // refunded by the admin client).
    match /payouts/{payoutId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read: if isStaff();
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.points is number
        && request.resource.data.points > 0
        && request.resource.data.coin is string
        && request.resource.data.address is string;
      // User may only cancel their own pending request; staff may set any status.
      allow update: if isStaff() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status == 'cancelled');
      allow delete: if isStaff();
    }

    // ── ORACLE PREDICTION MARKETS (live board) ─────────────────────────────
    // Markets are REAL: seeded from live crypto prices / search-grounded
    // events, and settled only from verified real-world evidence. Anyone
    // signed in can read the board; anyone may push the market forward by
    // placing a bet (their own stake, recorded on their own profile).
    // Settlement fields and market status are frozen the moment a market is
    // decided, so no client can rewrite a result or re-open a market.
    match /oracleMarkets/{marketId} {
      allow read: if isAuthenticated();

      function isBetForward() {
        let diff = request.resource.data.diff(resource.data);
        return
          diff.affectedKeys().hasOnly([
            'options', 'totalStaked', 'betCount'
          ]) &&
          // Stakes and bet count may only ever go up.
          request.resource.data.totalStaked > resource.data.totalStaked &&
          request.resource.data.betCount == resource.data.betCount + 1 &&
          // Options count and ids are immutable — only stakes may move.
          request.resource.data.options.size() == resource.data.options.size();
      }

      allow update: if isAuthenticated() &&
        resource.data.status == 'active' && isBetForward();

      // Anyone signed in may publish a market. The market carries no value
      // until somebody bets on it (the update rule below) and settlement is
      // frozen once it leaves the active state — so creation is safe.
      // endTime is an ISO-8601 string (matching the rest of the codebase).
      allow create: if isAuthenticated() &&
        request.resource.data.status == 'active' &&
        request.resource.data.options.size() == 2 &&
        request.resource.data.endTime is string &&
        request.resource.data.endTime.size() >= 10;

      // Status, settlement fields, and the existence of the doc itself are
      // not client-controllable.
      allow delete: if false;
    }

    // ── ARENA (server-written) ────────────────────────────────────────────
    match /oracleBets/{betId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read: if isStaff();
      allow write: if false;
    }

    match /growthPoolStakes/{stakeId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read: if isStaff();
      allow write: if false;
    }

    match /arenaTriviaSessions/{sessionId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read: if isStaff();
      allow write: if false;
    }

    match /oracleQuestions/{questionId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // ── COMMUNITY POSTS ────────────────────────────────────────────────────
    match /community/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;

      // Author may edit their own post; anyone may toggle a like or bump the
      // comment count, and nothing else.
      allow update: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'imageUrl', 'updatedAt'])) ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likes', 'commentCount', 'reactions'])
      );
      allow delete: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isStaff());

      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
          request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAuthenticated() &&
          (resource.data.userId == request.auth.uid || isStaff());
      }
    }

    // ── GROUPS ─────────────────────────────────────────────────────────────
    match /groups/{groupId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.creatorId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.creatorId == request.auth.uid ||
        // Joining/leaving only. totalPoints is server-maintained.
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
      );
      allow delete: if isStaff();
    }

    // ── REPORTS ────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow read, update, delete: if isStaff();
      allow create: if isAuthenticated();
    }

    // ── NOTIFICATIONS ──────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      allow read: if isStaff();
      // Recipient may only flip `read`.
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow update: if isStaff();
      // Client-created notifications remain allowed so DM/follow alerts keep
      // working; they carry no value and are addressed to a single recipient.
      allow create: if isAuthenticated() && (request.resource.data.type in ['follow', 'message'] || isStaff());
      allow delete: if isStaff();
    }

    // ── FOLLOWS (social graph) ──────────────────────────────────────────────
    // Deterministic id `{followerId}_{followingId}` makes duplicate edges
    // impossible. All writes go through api/follow.js (Admin SDK — rules are
    // bypassed there), because one follow must atomically update counters on
    // TWO user docs that no client is allowed to touch. Clients get read-only
    // access: the social graph is public information, like on any social app.
    match /follows/{followId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    // ── USERNAMES (handle claim docs) ───────────────────────────────────────
    // /usernames/{name} → { uid } backs the /@name profile URLs. The doc for a
    // handle is created and released ONLY by api/username.js in the same
    // transaction that updates the owner's users doc — that transaction is
    // what makes two users claiming one handle impossible. Clients can read
    // the claims (public info, like follows) but never write.
    match /usernames/{username} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }
    // ── SETTINGS ───────────────────────────────────────────────────────────
    // Public read: the landing page and maintenance gate read this pre-auth.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ── FRAME REQUESTS ─────────────────────────────────────────────────────
    match /frameRequests/{requestId} {
      allow read, update, delete: if isStaff();
      allow create: if isAuthenticated() &&
        request.auth.uid == request.resource.data.userId;
    }

    // ── CHATS & MESSAGES ───────────────────────────────────────────────────
    // Was `allow read, write: if isAuthenticated()` — every conversation in the
    // app was readable and writable by any signed-in account.
    match /chats/{chatId} {
      allow read: if isAuthenticated() &&
        request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants.size() == 2;
      // Participants may update conversation metadata (lastMessage, unreadBy).
      allow update: if isAuthenticated() &&
        request.auth.uid in resource.data.participants &&
        request.resource.data.participants == resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatParticipant(chatId);
        // You may only send as yourself, and only into a chat you are in.
        allow create: if isChatParticipant(chatId) &&
          request.resource.data.senderId == request.auth.uid;
        // Two disjoint update surfaces:
        //   • any participant may add reactions or read receipts — content
        //     keys untouched;
        //   • ONLY the sender may edit or soft-delete their own message
        //     (text/media swap within the app's edit window). Nobody — not
        //     even the other participant — can rewrite someone else's words.
        allow update: if isChatParticipant(chatId) && (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['reactions', 'readBy']) ||
          (resource.data.senderId == request.auth.uid &&
           request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['text', 'mediaUrl', 'mediaType', 'isEdited', 'editedAt', 'deleted', 'deletedAt']))
        );
        allow delete: if isAuthenticated() &&
          resource.data.senderId == request.auth.uid;
      }
    }
  }
}
